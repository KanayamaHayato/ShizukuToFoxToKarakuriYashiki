  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "END2\u96EB\u3068\u5C4B\u4EE3"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6700\u5F8C\u306E\u706F\u7C60\u3060\u3002\n\u541B\u306A\u3089\u706F\u3057\u3066\u304F\u308C\u308B\u3088\u306D\uFF1F"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306D\u3047\u5C4B\u4EE3\u3002\n\u4E00\u3064\u3060\u3051\u805E\u3044\u3066\u3044\u3044\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3093\uFF1F"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u706F\u7C60\u3092\u706F\u3059\u3053\u3068\u3067\u306F\u5E30\u308C\u306A\u3044\u3002\n\u305D\u3046\u3067\u3057\u3087\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "......\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3069\u3046\u3057\u3066\u305D\u3046\u601D\u3046\u3093\u3060\u3044\uFF1F"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u601D\u3044\u51FA\u3057\u305F\u306E\u3002\n\u304A\u3070\u3042\u3061\u3083\u3093\u304C\u4F4F\u3093\u3067\u3044\u305F\u96C6\u843D\u306B\u306F\u8A00\u3044\u4F1D\u3048\u304C\u3042\u3063\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4E00\u5E74\u306B\u4E8C\u56DE\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u751F\u8D04\u3092\u6367\u3052\u308B\u5100\u5F0F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4E11\u306E\u523B\u306B\u3001\u96C6\u843D\u304B\u3089\u7960\u307E\u3067\u7D9A\u304F\u706F\u7C60\u306B\u706B\u3092\u706F\u3059\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u751F\u8D04\u306B\u9078\u3070\u308C\u305F\u4EBA\u306F\u3001\u305F\u3060\u706F\u7C60\u3092\u706F\u3059\u3060\u3051\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u79C1\u306F\u6700\u521D\u305A\u3063\u3068\u4E0D\u601D\u8B70\u3060\u3063\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306A\u3093\u3067\u3053\u3093\u306A\u5C4B\u6577\u304C\u5FC5\u8981\u306A\u3093\u3060\u308D\u3046\u3063\u3066\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3067\u3082\u5C4B\u4EE3\u306F\u795E\u69D8\u3060\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3053\u3093\u306A\u5C4B\u6577\u304F\u3089\u3044\u4F5C\u308C\u308B\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: ......
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u751F\u8D04\u3092\u8FF7\u308F\u305B\u308B\u305F\u3081\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3088\u304F\u6C17\u4ED8\u3044\u305F\u306D\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3067\u3082\u3053\u308C\u3067\u304A\u3057\u307E\u3044\u304B...\u3002\n\u6C17\u3065\u304B\u308C\u305F\u306A\u3089\u30FC\u30FC"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3067\u3082\u3002\n\u3082\u3046\u4E00\u3064\u601D\u3044\u51FA\u3057\u305F\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "...\uFF01"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u307E\u3060\u5C0F\u3055\u304B\u3063\u305F\u9803\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u7960\u306E\u524D\u3067\u5F31\u3063\u3066\u308B\u72D0\u3092\u898B\u3064\u3051\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u98DF\u3079\u7269\u3068\u304A\u6C34\u3092\u3042\u3052\u3066\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6BCE\u65E5\u4F1A\u3044\u306B\u884C\u3063\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6697\u304F\u306A\u308B\u307E\u3067\u904A\u3093\u3060\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u79C1\u305F\u3061\u89AA\u53CB\u3060\u3063\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3067\u3082\u534A\u5E74\u304F\u3089\u3044\u7D4C\u3063\u305F\u9803\u3002\n\u6025\u306B\u3044\u306A\u304F\u306A\u3063\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u79C1\u306F\u305D\u306E\u5F8C\u3059\u3050\u5F15\u3063\u8D8A\u3057\u305F\u304B\u3089\u3002\n\u3082\u3046\u96C6\u843D\u306E\u3053\u3068\u306A\u3093\u3066\u5FD8\u308C\u3066\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3067\u3082\u4ECA\u601D\u3044\u51FA\u3057\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5C4B\u4EE3\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3042\u306E\u72D0\u306F\u3042\u306A\u305F\u3060\u3063\u305F\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u601D\u3044\u51FA\u3057\u305F\u3093\u3060\u306D"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5C4B\u4EE3\u306F\u60AA\u3044\u72D0\u3060\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u305F\u304F\u3055\u3093\u306E\u4EBA\u3092\u751F\u8D04\u306B\u3057\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4ECA\u3060\u3063\u3066\u79C1\u3092\u751F\u8D04\u306B\u3057\u3088\u3046\u3068\u3057\u3066\u308B\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3067\u3082\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u79C1\u306F\u77E5\u3063\u3066\u308B\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u672C\u5F53\u306F\u512A\u3057\u3044\u3053\u3068\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u672C\u5F53\u306F..."
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3055\u307F\u3057\u304B\u3063\u305F\u3093\u3067\u3057\u3087...\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "......\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u512A\u3057\u3044\uFF1F\n\u50D5\u304C\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3093\u306A\u308F\u3051\u306A\u3044\u3060\u308D\u3046\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u7D42\u308F\u3089\u305B\u3088\u3046\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3082\u3046\u8AB0\u3082\u4EBA\u3055\u3089\u3044\u306A\u3093\u304B\u3057\u306A\u304F\u3066\u3044\u3044\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3082\u3046...\u30FC\u4EBA\u3067\u306A\u304F\u3066\u3044\u3044..."
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5E30\u308D\u3046\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4E00\u7DD2\u306B\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3042\u308A\u304C\u3068\u3046"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u96EB\u3002"
