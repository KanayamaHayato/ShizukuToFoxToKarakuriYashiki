  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "\u5C4B\u4EE3\u3068\u306E\u4F1A\u8A71"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\uFF1F\uFF1F"
    text: "\u3084\u3042\u3002"
  - speakerName: "\u96EB"
    text: "\u72D0......\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u307C\u304F\u306F\u5C4B\u4EE3\uFF01"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u72D0\u3067\u306F\u3042\u308B\u3051\u3069\u3001\u305D\u308C\u3060\u3051\u3058\u3083\u306A\u3044\u304B\u306A\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u305D\u308C\u3060\u3051\u3058\u3083\u306A\u3044\u3063\u3066\u3069\u3046\u3044\u3046\u3053\u3068\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u307E\u3041\u3001\u5F37\u3044\u3066\u8A00\u3046\u306A\u3089\u795E\u69D8\u304B\u306A\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306F\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u795E\u69D8\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3044\u3084\u7D76\u5BFE\u5618\u3067\u3057\u3087\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u795E\u69D8\u3060\u3063\u305F\u3089\u3053\u3053\u304B\u3089\u51FA\u3057\u3066\u3088\uFF01"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3046\u30FC\u3093\u3002\n\u305D\u308C\u306F\u7121\u7406\u304B\u306A\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u4ECA\u306E\u50D5\u306B\u306F\u305D\u3093\u306A\u529B\u306F\u306A\u3044\u3093\u3060\u3002\n\u3067\u3082\u5B89\u5FC3\u3057\u3066\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3061\u3083\u3093\u3068\u3053\u3053\u3092\u51FA\u308B\u65B9\u6CD5\u306F\u3042\u308B\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u672C\u5F53\u2026\u2026\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3082\u3061\u308D\u3093\u3002\n\u3053\u3053\u304B\u3089\u51FA\u305F\u3044\u306A\u3089......"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u300C\u3053\u306E\u5C4B\u6577\u306B\u3042\u308B\u706F\u7C60\u3092\u3059\u3079\u3066\u706F\u3059\u3053\u3068\u3002\u300D\n\u305D\u308C\u3060\u3051\u3055\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u706F\u7C60\u2026\u2026\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3046\u3002\n\u3059\u3079\u3066\u306E\u706F\u7C60\u306B\u706B\u3092\u706F\u305B\u3070\u3001\u3053\u306E\u5C4B\u6577\u304B\u3089\u51FA\u3089\u308C\u308B\u3002\n\u7C21\u5358\u3060\u308D\u3046\uFF1F"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3044\u3084\u5168\u7136\u7C21\u5358\u305D\u3046\u306B\u805E\u3053\u3048\u306A\u3044\u3093\u3060\u3051\u3069\u2026\u2026\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u5927\u4E08\u592B\u3002\n\u541B\u306A\u3089\u304D\u3063\u3068\u3067\u304D\u308B\u3088\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "...\u304A\u3063\u3068\u3002\n\u3082\u3046\u6642\u9593\u307F\u305F\u3044\u3060\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6642\u9593...\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u8272\u3005\u4E8B\u60C5\u304C\u3042\u3063\u3066\u306D\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3042\u3041\u3001\u305D\u3046\u3060\u3002"
  - speakerName: "\u5C4B\u4EE3\U0001F15F"
    text: "\u305D\u306E\u304A\u672D\u306F\u5927\u4E8B\u306B\u3059\u308B\u3068\u3044\u3044\u3002"
  - speakerName: "\u5C4B\u4EE3\U0001F15F"
    text: "\u5168\u90E8\u306A\u304F\u3057\u305F\u3089\u3001\u7D42\u308F\u308A\u3060\u304B\u3089\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u7D42\u308F\u308A\u3063\u3066\u3069\u3046\u3044\u3046\u2015\u2015"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u308C\u3058\u3083\u3001\u307E\u305F\u5F8C\u3067\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3061\u3087\u3063\u3068\uFF01"
