  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3088\u3046\u3053\u305D\uFF01"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3053\u3053\u306F...\uFF1F"
  - speakerName: "\u5C4B\u4EE3\U0001F15F"
    text: "\u3053\u3053\u306F\u6700\u5F8C\u306E\u706F\u7C60\u304C\u3042\u308B\u90E8\u5C4B\u3060\u3088\n\u541B\u304C\u307B\u3068\u3093\u3069\u306E\u706F\u7C60\u306B\u706B\u3092\u706F\u3057\u3066\u304F\u308C\u305F\u304B\u3089\u3053\u3053\u307E\u3067\u30EF\u30FC\u30D7\u3057\u3066\u3042\u3052\u305F\u3093\u3060\uFF01"
  - speakerName: "\u5C4B\u4EE3\U0001F15F"
    text: "\u3055\u3042\u6B8B\u3059\u306F\u76EE\u306E\u524D\u306E\u706F\u7C60\u4E00\u3064\u3060\u3051\u3060\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3053\u308C\u3092\u706F\u3057\u305F\u3089\u5E30\u308C\u308B\u306E\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3046\u3060\u306D\u5E30\u308C\u308B\u3002"
