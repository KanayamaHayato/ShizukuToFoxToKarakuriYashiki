  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u304A\u3001\u6700\u521D\u306E\u4E00\u3064\u3060\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5C4B\u4EE3\uFF1F\u305D\u3053\u306B\u3044\u308B\u306E...\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u50D5\u306F\u3053\u3053\u306B\u3044\u308B\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3060\u3063\u305F\u3089\u59FF\u3092\u898B\u305B\u3066\uFF01\n\u805E\u304D\u305F\u3044\u3053\u3068\u304C\u305F\u304F\u3055\u3093\u3042\u308B\u306E\uFF01"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u308C\u306F\u96E3\u3057\u3044\u304B\u306A\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3058\u3083\u3001\u6B21\u3082\u9811\u5F35\u3063\u3066\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3061\u3087\u3063\u3068\uFF01\uFF01"
