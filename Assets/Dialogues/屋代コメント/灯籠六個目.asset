  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "\u706F\u7C60\u516D\u500B\u76EE"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6B8B\u3059\u3068\u3053\u308D\u3042\u3068\u4E00\u500B\u3063\u3066\u3068\u3053\u304B\u306A\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u305D\u3046\u306A\u306E\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3055\u3042\u3069\u3046\u3060\u308D\u3046\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4F55\u305D\u308C\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "...\u305D\u3046\u3044\u3048\u3070\u3002\n\u3042\u3093\u305F\u3063\u3066\u4EBA\u9593\u304C\u5ACC\u3044\u306A\u306E\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: ...
  - speakerName: "\u5C4B\u4EE3"
    text: "\u5ACC\u3044\u3058\u3083\u306A\u3044\u3088\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305F\u3060\u3002\n\u307F\u3093\u306A\u50D5\u3092\u7F6E\u3044\u3066\u3044\u304F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3048\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u308C\u3060\u3051\u3055\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6700\u5F8C\u306E\u706F\u7C60\u3082\u8FD1\u3044\u3002\n\u9811\u5F35\u3063\u3066\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306A\u3093\u306A\u306E\u3088...\u3002"
