  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u9806\u8ABF\u3060\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3042\uFF01\n\u4ECA\u5EA6\u3053\u305D\u51FA\u3066\u304D\u3066\u3088\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u307E\u3042\u307E\u3042\u843D\u3061\u7740\u3044\u3066\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3055\u3063\u304D\u304B\u3089\u3001\u4F55\u306A\u306E\u3088\u6025\u306B\u8A71\u3057\u304B\u3051\u305F\u3068\u601D\u3063\u305F\u3089\u3059\u3050\u6D88\u3048\u3066...\uFF01"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u8272\u3005\u3042\u308B\u3093\u3060\u3088\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u795E\u69D8\u306B\u3082\u306D"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u7D76\u5BFE\u8AAC\u660E\u3059\u308B\u6C17\u306A\u3044\u3067\u3057\u3087...\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3063\u3066\u3042\u308C\u805E\u3044\u3066\u308B\uFF01\uFF1F"
