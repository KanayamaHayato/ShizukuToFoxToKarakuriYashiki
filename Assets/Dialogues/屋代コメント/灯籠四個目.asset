  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "\u706F\u7C60\u56DB\u500B\u76EE"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u56DB\u500B\u76EE\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306D\u3048\u3001\u4E00\u500B\u524D\u306B\u8A00\u3063\u3066\u305F\u9762\u767D\u3044\u8A71\u3063\u3066\u4F55\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3046\u3060\u306D\u3002\n\u7D04\u675F\u901A\u308A\u9762\u767D\u3044\u8A71\u3092\u3057\u3088\u3046\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6614\u3005\u3001\u3053\u306E\u8FBA\u308A\u4E00\u5E2F\u306B\u306F\u5C0F\u3055\u306A\u96C6\u843D\u304C\u3042\u3063\u305F\u3093\u3060\u3002\n\u4ECA\u3058\u3083\u4FE1\u3058\u3089\u308C\u306A\u3044\u3060\u308D\u3046\u3051\u3069\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3078\u3048\u3002\n\u3053\u3093\u306A\u5C71\u306E\u4E2D\u306B\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u5B50\u4F9B\u305F\u3061\u304C\u8D70\u308A\u56DE\u3063\u3066\u3002\n\u7551\u3092\u8015\u3057\u3066\u3002\n\u796D\u308A\u306E\u65E5\u306B\u306F\u591C\u307E\u3067\u706F\u308A\u304C\u6D88\u3048\u306A\u304B\u3063\u305F\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3067\u3082\u4E0D\u601D\u8B70\u3060\u3088\u3002\n\u3042\u3093\u306A\u306B\u8CD1\u3084\u304B\u3060\u3063\u305F\u306E\u306B\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6C17\u3065\u3044\u305F\u3089\u307F\u3093\u306A\u3044\u306A\u304F\u306A\u3063\u3066\u3044\u305F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5F15\u3063\u8D8A\u3057\u305F\u3068\u304B\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u306F\u306F\u306F\u3002\n\u305D\u3046\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6B7B\u3093\u3060\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002\n\u5FD8\u308C\u305F\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u4EBA\u9593\u306F\u3059\u3050\u3044\u306A\u304F\u306A\u308B\u304B\u3089\u306D"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306A\u3093\u304B\u6012\u3063\u3066\u308B\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u307E\u3055\u304B\u3002\n\u305F\u3060\u306E\u6614\u8A71\u3060\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3063\u3066\u3053\u308C\u306E\u3069\u3053\u304C\u304A\u3082\u3057\u308D\u3044\u8A71\u306A\u306E\u3088\u3002"
