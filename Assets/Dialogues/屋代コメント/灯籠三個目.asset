  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "\u706F\u7C60\u4E09\u500B\u76EE"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u304A\u3084\u3002\n\u3082\u3046\u4E09\u3064\u3081\u304B\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4ECA\u5EA6\u306F\u9003\u3052\u308B\u524D\u306B\u8A71\u3057\u3066\u3082\u3089\u3046\u3088\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u50D5\u306F\u9003\u3052\u3066\u306A\u3044\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3060\u3063\u305F\u3089\u805E\u304B\u305B\u3066\u3002\n\u3053\u306E\u5C4B\u6577\u306F\u3001\u3044\u3063\u305F\u3044\u4F55\u306A\u306E\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: ...
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3046\u3060\u306D\u3047\u3002\n\u3042\u3093\u307E\u308A\u5C45\u5FC3\u5730\u306E\u3044\u3044\u3082\u306E\u3058\u3083\u306A\u3044\u306A\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u305D\u308C\u306F\u8A00\u308F\u308C\u306A\u304F\u3066\u3082\u3002\n\u5316\u3051\u7269\u3082\u3044\u308B\u3057..."
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3042\u306F\u306F\u3002\n\u78BA\u304B\u306B\u3002\n\u3042\u308C\u306F\u5371\u306A\u3044\u306D\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5371\u306A\u3044\u306D...\u3058\u3083\u306A\u3044\u3067\u3057\u3087\uFF01"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6614\u304B\u3089\u3053\u306E\u5C4B\u6577\u306B\u306F\u3042\u3044\u3064\u304C\u3044\u308B\u3093\u3060\u3088\u3002\n\u305D\u308C\u306B\u3053\u3053\u306F\u5B9A\u671F\u7684\u306B\u541B\u307F\u305F\u3044\u306B\u8FF7\u3044\u8FBC\u3080\u4EBA\u304C\u3044\u308B\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u8FF7\u3044\u8FBC\u3080\u4EBA...\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3046\u3093\u3002\n\u541B\u4EE5\u5916\u306B\u3082\u6642\u3005\u3053\u3053\u306B\u6765\u308B\u4EBA\u306F\u3044\u308B\u3088\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6642\u3005\u3063\u3066"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u5FD8\u308C\u305F\u3053\u308D\u306B\u8AB0\u304B\u304C\u8FF7\u3044\u8FBC\u3080\u3002\n\u305D\u3093\u306A\u5834\u6240\u306A\u3093\u3060\u3088\u3001\u3053\u3053\u306F\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u5168\u7136\u5B89\u5FC3\u3067\u304D\u306A\u3044\u3093\u3060\u3051\u3069......\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u5927\u4E08\u592B\u3002\n\u541B\u306F\u50D5\u304C\u898B\u3066\u308B\u304B\u3089\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u6B21\u306F\u3082\u3046\u5C11\u3057\u9762\u767D\u3044\u8A71\u3092\u3057\u3088\u3046\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6B21\u3060\u306A\u3093\u3066...\n\u3044\u3063\u305F\u3044\u706F\u7C60\u306F\u3044\u304F\u3064\u3042\u308B\u306E\u3088\uFF01"
