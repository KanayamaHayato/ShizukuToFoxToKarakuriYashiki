  lines:
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3082\u3046\u4E94\u500B\u76EE\u304B\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u96EB\u306F\u3042\u306E\u5316\u3051\u7269\u306F\u6016\u3044\u304B\u3044\uFF1F"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u305D\u308C\u306F\u3082\u3061\u308D\u3093\u3067\u304D\u308C\u3070\u4F1A\u3044\u305F\u304F\u306A\u3044\u306D\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u305D\u3046\u304B\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u3042\u306E\u602A\u7269\u306F\u6614\u304B\u3089\u3053\u3053\u3092\u5F77\u5FA8\u3063\u3066\u3044\u308B\u3002\n\u305D\u3057\u3066\u3069\u3046\u3084\u3089\u706F\u7C60\u306E\u5149\u3092\u5ACC\u3046\u3089\u3057\u3044\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u6614\u304B\u3089\uFF1F"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u50D5\u3082\u3042\u3044\u3064\u304C\u6016\u3044\u3088\u3002\n\u7F6E\u3044\u3066\u3044\u304B\u308C\u305F\u8005\u305F\u3061\u306E..."
  - speakerName: "\u5C4B\u4EE3"
    text: ......
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u306A\u306B\u305D\u308C\u3002"
  - speakerName: "\u5C4B\u4EE3"
    text: "\u72EC\u308A\u8A00\u3055\u3002"
