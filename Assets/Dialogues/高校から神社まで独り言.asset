  m_Script: {fileID: 11500000, guid: 9333994b6bd812f4baaf91df79117665, type: 3}
  m_Name: "\u9AD8\u6821\u304B\u3089\u795E\u793E\u307E\u3067\u72EC\u308A\u8A00"
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3042\u30FC\u3001\u3084\u3063\u3068\u7D42\u308F\u3063\u305F\uFF5E\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3053\u308C\u3067\u5E30\u308C\u308B\uFF5E\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u4ECA\u65E5\u306E\u6388\u696D\u3001\u3044\u3064\u3082\u3088\u308A\u9577\u304F\u611F\u3058\u305F\u308F\u2026\u2026\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3042\u3063\uFF01\u305D\u3046\u3044\u3048\u3070\uFF01"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u304A\u3070\u3042\u3061\u3083\u3093\u306B\u795E\u793E\u3078\u304A\u672D\u3092\u8FD4\u3057\u306B\u884C\u304F\u3088\u3046\u8A00\u308F\u308C\u3066\u305F\u3093\u3060\uFF01"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3046\uFF5E\u3093\u2026\u2026\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u3081\u3093\u3069\u304F\u3055\u3044\u3051\u3069\u3001\u884C\u304F\u304B\u3041\u2026\u2026\u3002"
  - speakerName: "\u685C\u5C4B\u6577 \u96EB"
    text: "\u78BA\u304B\u3053\u306E\u5148\u3092\u66F2\u304C\u3063\u305F\u3068\u3053\u308D\u3060\u3063\u305F\u3088\u306D\u3002"
